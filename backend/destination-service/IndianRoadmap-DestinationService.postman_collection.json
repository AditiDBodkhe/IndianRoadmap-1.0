{
  "info": {
    "name": "IndianRoadmap — Destination Service",
    "description": "Complete REST API collection for the destination-service microservice.\n\nBase URL: http://localhost:8081\n\nRun requests in order — the 'Create Destination' request auto-saves the returned ID into the collection variable {{destinationId}}, which is used by Get/Update/Delete requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "destinationId",
      "value": "",
      "type": "string",
      "description": "Auto-populated by the 'Create Destination' request test script"
    },
    {
      "key": "destinationSlug",
      "value": "chhitkul",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Actuator Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            },
            "description": "Spring Boot Actuator health check. Returns service status and MongoDB connection status."
          },
          "response": [
            {
              "name": "Health UP",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"UP\",\n  \"components\": {\n    \"mongo\": { \"status\": \"UP\" },\n    \"ping\": { \"status\": \"UP\" }\n  }\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Health status is UP', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('UP');",
                  "    pm.expect(body.components.mongo.status).to.eql('UP');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Destinations — CRUD",
      "item": [
        {
          "name": "Create Destination",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/destinations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "destinations"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"chhitkul\",\n  \"name\": {\n    \"defaultName\": \"Chhitkul\",\n    \"localName\": \"Chhitkul\"\n  },\n  \"state\": \"Himachal Pradesh\",\n  \"district\": \"Kinnaur\",\n  \"region\": \"Kinnaur\",\n  \"shortDescription\": \"India's last inhabited village near the Indo-Tibet border\",\n  \"description\": \"Chhitkul is a small village in the Sangla Valley in the Kinnaur district of Himachal Pradesh. It is the last inhabited village near the Indo-Tibet border.\",\n  \"latitude\": 31.35,\n  \"longitude\": 78.44,\n  \"elevationMeters\": 3450,\n  \"elevationFeet\": 11319,\n  \"categories\": [\"VILLAGE\", \"HERITAGE\", \"BORDER\"],\n  \"moods\": [\"ADVENTURE\", \"SOLITUDE\", \"HERITAGE\"],\n  \"languages\": [\"ENGLISH\", \"HINDI\", \"KINNAURI\"],\n  \"historicalHighlights\": [\n    {\n      \"era\": \"Ancient\",\n      \"title\": \"Last Indo-Tibet Trade Route Village\",\n      \"description\": \"Historically a stop on the old Indo-Tibet trade route\"\n    }\n  ],\n  \"culturalInformation\": {\n    \"traditions\": \"Kinnauri Buddhist traditions\",\n    \"cuisine\": \"Traditional Kinnauri food\",\n    \"festivals\": [\"Losar\", \"Fagli\"],\n    \"attire\": \"Traditional Kinnauri cap and shawl\",\n    \"notes\": \"\"\n  },\n  \"architecture\": {\n    \"style\": \"Himalayan timber and stone\",\n    \"materials\": \"Local stone and wood\",\n    \"period\": \"Medieval to contemporary\",\n    \"notableFeatures\": \"Traditional Kinnauri architecture with flat roofs\"\n  },\n  \"attractions\": [\n    {\n      \"name\": \"Chhitkul Temple\",\n      \"type\": \"TEMPLE\",\n      \"description\": \"Ancient temple dedicated to local deity\"\n    },\n    {\n      \"name\": \"Baspa River\",\n      \"type\": \"NATURE\",\n      \"description\": \"Scenic Baspa River flowing through the valley\"\n    }\n  ],\n  \"images\": [\n    {\n      \"url\": \"\",\n      \"caption\": \"Chhitkul village view\",\n      \"photographer\": \"\",\n      \"source\": \"\"\n    }\n  ],\n  \"sources\": [\n    {\n      \"title\": \"Himachal Pradesh Tourism\",\n      \"publisher\": \"Government of Himachal Pradesh\",\n      \"url\": \"https://himachaltourism.gov.in\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Create a new destination. Returns 201 Created with the full destination object.\n\nThe test script automatically saves the returned ID into {{destinationId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Response structure is valid', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data).to.have.property('id');",
                  "    pm.expect(body.data.slug).to.eql('chhitkul');",
                  "    pm.expect(body.data.coordinates.latitude).to.eql(31.35);",
                  "    pm.expect(body.data.coordinates.longitude).to.eql(78.44);",
                  "    pm.expect(body.data.elevation.meters).to.eql(3450);",
                  "    // Save ID for subsequent requests",
                  "    pm.collectionVariables.set('destinationId', body.data.id);",
                  "    pm.collectionVariables.set('destinationSlug', body.data.slug);",
                  "    console.log('Saved destinationId:', body.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Destination by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/destinations/{{destinationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "destinations", "{{destinationId}}"]
            },
            "description": "Fetch a single destination by its MongoDB ObjectId.\n\n{{destinationId}} is auto-set by the Create request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Correct destination returned', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data.id).to.eql(pm.collectionVariables.get('destinationId'));",
                  "    pm.expect(body.data).to.have.property('elevation');",
                  "    pm.expect(body.data).to.have.property('coordinates');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Destination by Slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/destinations/slug/{{destinationSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "destinations", "slug", "{{destinationSlug}}"]
            },
            "description": "Fetch a destination by its URL-safe slug (e.g. 'chhitkul', 'adi-kailash').\n\nSlugs are case-insensitive and normalized server-side."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Correct slug returned', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data.slug).to.eql(pm.collectionVariables.get('destinationSlug'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Destination",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/destinations/{{destinationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "destinations", "{{destinationId}}"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shortDescription\": \"India's last inhabited village near the Indo-Tibet border — updated\",\n  \"moods\": [\"ADVENTURE\", \"SOLITUDE\", \"HERITAGE\", \"WILD\"],\n  \"attractions\": [\n    {\n      \"name\": \"Chhitkul Temple\",\n      \"type\": \"TEMPLE\",\n      \"description\": \"Ancient temple dedicated to local deity\"\n    },\n    {\n      \"name\": \"Baspa River\",\n      \"type\": \"NATURE\",\n      \"description\": \"Scenic Baspa River flowing through the valley\"\n    },\n    {\n      \"name\": \"Indo-Tibet Border Viewpoint\",\n      \"type\": \"VIEWPOINT\",\n      \"description\": \"Last motorable road viewpoint towards the Tibet border\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Partially update a destination. Only fields present in the request body are updated.\n\nAll fields in UpdateDestinationRequest are optional — omit any field to leave it unchanged."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Field updated', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data.shortDescription).to.include('updated');",
                  "    pm.expect(body.data.moods).to.include('WILD');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Destination",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/destinations/{{destinationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "destinations", "{{destinationId}}"]
            },
            "description": "Delete a destination by ID. Returns 204 No Content on success."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Body is empty', () => pm.expect(pm.response.text()).to.eql(''));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Destinations — Search & Filter",
      "item": [
        {
          "name": "List All Destinations (default page)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/destinations?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "destinations"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "List all destinations with pagination. Returns summary cards (not full detail)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Paginated response structure', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
