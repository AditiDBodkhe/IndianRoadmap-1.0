                { "key": "radius", "value": "100000", "description": "100km in meters" }
              ]
            },
            "description": "Find destinations within a given radius.\n\nParameters:\n- latitude: -90 to +90\n- longitude: -180 to +180\n- radius: meters (e.g. 50000 = 50km)\n\nUses MongoDB 2dsphere geospatial index internally. Results are not sorted by distance in the current implementation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Returns nearby destinations', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data).to.be.an('array');",
                  "    pm.expect(body.data.length).to.be.greaterThan(0);",
                  "    console.log('Nearby destinations:', body.data.map(d => d.slug));",
                  "});"
                ],
