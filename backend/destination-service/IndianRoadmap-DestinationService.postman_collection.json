    {
      "name": "Error Scenarios",
      "item": [
        {
          "name": "404 — Destination Not Found (by ID)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/destinations/000000000000000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "destinations", "000000000000000000000000"]
            },
            "description": "Non-existent ID returns 404 with structured error response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('Error response structure', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.false;",
                  "    pm.expect(body.error.code).to.eql('DESTINATION_NOT_FOUND');",
                  "    pm.expect(body.error.message).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "404 — Destination Not Found (by slug)",
          "request": {
