# ─────────────────────────────────────────────────────────────────────────────
# IndianRoadmap — Local Development Environment Variables
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED: minimum 32 characters, keep this secret
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Host port exposed for local DB tooling (e.g. MongoDB Compass)
MONGODB_PORT=27017

# ── Service URLs (used inside Docker network) ────────────────────────────────
# These default values are correct for docker-compose — do not change unless
# you rename service containers.
DESTINATION_SERVICE_URL=http://destination-service:8081
ROADMAP_SERVICE_URL=http://roadmap-service:8082
STORY_SERVICE_URL=http://story-service:8083
AUDIO_SERVICE_URL=http://audio-service:8084
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8085
USER_SERVICE_URL=http://user-service:8086
AI_SERVICE_URL=http://ai-service:8090

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Angular frontend
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Gateway Timeouts ─────────────────────────────────────────────────────────
GATEWAY_CONNECT_TIMEOUT_MS=3000
GATEWAY_RESPONSE_TIMEOUT_MS=10000

# ── JWT Token Expiry ─────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=2592000
